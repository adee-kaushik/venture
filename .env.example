# Required: PostgreSQL connection string and a securely generated session secret.
DATABASE_URL=
ADMIN_SESSION_SECRET=

# Optional platform-administrator password (12+ characters).
# Business owners register with their own email/password at /signup.
ADMIN_PASSWORD=

# Optional generative AI provider; otherwise knowledge-matching replies are used.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Optional WhatsApp Cloud API connection.
WHATSAPP_VERIFY_TOKEN=
META_APP_SECRET=
WHATSAPP_TOKEN=
WHATSAPP_BUSINESS_MAPPING={}
